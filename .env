# Mock Service Worker serves the API responses (no real backend yet).
# Set to "disabled" to hit a real API instead.
VITE_API_MOCKING=enabled

# Base URL for API requests, inlined at build time. "/api" means the same origin
# as the app. Override per environment (e.g. .env.production.local or a CI env var),
# for example https://api.example.com/v1
VITE_API_BASE_URL=/api
